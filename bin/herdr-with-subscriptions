#!/usr/bin/env python3
"""Launch the companion Herdr client; never replace or stop the Herdr server."""
from pathlib import Path
import os
import subprocess
import sys

project = Path(__file__).resolve().parent.parent
client = project / "native/bin/herdr"
if not client.is_file():
    raise SystemExit("Companion client is missing. Run: python3 scripts/build-client.py")
if sys.argv[1:] in (["--help"], ["--version"], ["-V"]):
    os.execv(str(client), [str(client), *sys.argv[1:]])
if os.environ.get("HERDR_ENV") == "1":
    raise SystemExit("Detach this Herdr client first (Ctrl+B then Q), then run this command at the outer shell. Your agents stay running.")
subprocess.run([sys.executable, "-m", "herdr_subscriptions", "setup", "--section", "--apply"], cwd=project, check=True)
path = subprocess.check_output([sys.executable, "-m", "herdr_subscriptions", "section-path"], cwd=project, text=True).strip()
environment = dict(os.environ, HERDR_SUBSCRIPTIONS_FILE=path)
os.execve(str(client), [str(client), *sys.argv[1:]], environment)
