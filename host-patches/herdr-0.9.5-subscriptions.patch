diff --git a/src/client/shell/subscription_section.rs b/src/client/shell/subscription_section.rs
new file mode 100644
index 0000000..8e95392
--- /dev/null
+++ b/src/client/shell/subscription_section.rs
@@ -0,0 +1,404 @@
+//! Optional, client-owned sidebar section fed by a local plugin JSON file.
+//! The server protocol and agent/workspace metadata are deliberately unchanged.
+use std::path::PathBuf;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use ratatui::{
+    buffer::Buffer,
+    layout::Rect,
+    style::{Modifier, Style},
+};
+use serde::Deserialize;
+
+use crate::app::state::Palette;
+
+const MAX_BYTES: u64 = 64 * 1024;
+const MAX_ROWS: usize = 64;
+
+#[derive(Clone, Debug, Default, PartialEq, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+struct Row {
+    text: String,
+    kind: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Document {
+    schema: u32,
+    title: String,
+    valid_until: f64,
+    rows: Vec<Row>,
+}
+
+#[derive(Default)]
+pub(super) struct SubscriptionSection {
+    path: Option<PathBuf>,
+    last_poll: Option<Instant>,
+    modified: Option<SystemTime>,
+    document: Option<Document>,
+    stale: bool,
+}
+
+impl SubscriptionSection {
+    pub(super) fn from_env() -> Self {
+        Self {
+            path: std::env::var_os("HERDR_SUBSCRIPTIONS_FILE").map(PathBuf::from),
+            ..Self::default()
+        }
+    }
+
+    /// Called once per client tick, throttled to one filesystem read per second.
+    /// No file IO occurs in render, and polling does not scale with pane count.
+    pub(super) fn poll(&mut self, now: Instant) -> bool {
+        let Some(path) = self.path.as_ref() else {
+            return false;
+        };
+        if self
+            .last_poll
+            .is_some_and(|last| now.saturating_duration_since(last) < Duration::from_secs(1))
+        {
+            return false;
+        }
+        self.last_poll = Some(now);
+        let epoch = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(0.0, |d| d.as_secs_f64());
+        let old_stale = self.stale;
+        let metadata = std::fs::metadata(path).ok();
+        let modified = metadata.as_ref().and_then(|m| m.modified().ok());
+        if metadata
+            .as_ref()
+            .is_none_or(|m| !m.is_file() || m.len() > MAX_BYTES)
+        {
+            self.stale = true;
+            return self.stale != old_stale;
+        }
+        let mut changed = false;
+        if self.document.is_none() || modified != self.modified {
+            let next = std::fs::read(path)
+                .ok()
+                .and_then(|bytes| {
+                    if bytes.len() as u64 > MAX_BYTES {
+                        return None;
+                    }
+                    serde_json::from_slice::<Document>(&bytes).ok()
+                })
+                .filter(|doc| {
+                    doc.schema == 1 && doc.rows.len() <= MAX_ROWS && doc.valid_until.is_finite()
+                });
+            if let Some(mut next) = next {
+                next.title = clean(&next.title, 64);
+                for row in &mut next.rows {
+                    row.text = clean(&row.text, 160);
+                }
+                changed = self.document.as_ref() != Some(&next);
+                self.document = Some(next);
+                self.modified = modified;
+            } else {
+                self.stale = true;
+                return old_stale != self.stale;
+            }
+        }
+        self.stale = self
+            .document
+            .as_ref()
+            .is_some_and(|d| d.valid_until < epoch);
+        changed || self.stale != old_stale
+    }
+
+    pub(super) fn action_at(&self, area: Rect, scroll: usize, point: (u16, u16)) -> Option<&str> {
+        let doc = self.document.as_ref()?;
+        if self.stale
+            || !super::contains(area, point)
+            || point.0 <= area.x
+            || point.0 >= area.right().saturating_sub(1)
+        {
+            return None;
+        }
+        let y = point.1.checked_sub(area.y + 2)?;
+        let height = usize::from(area.height.saturating_sub(2));
+        let index = scroll.min(doc.rows.len().saturating_sub(height)) + usize::from(y);
+        let row = doc.rows.get(index)?;
+        if usize::from(point.0 - area.x - 1) >= row.text.len() {
+            return None;
+        }
+        match row.kind.as_str() {
+            "reset_codex" => Some("codex"),
+            "reset_claude" => Some("claude"),
+            kind => {
+                let (action, id) = kind.split_once(':')?;
+                let valid_id = !id.is_empty()
+                    && id.len() <= 40
+                    && id.as_bytes()[0].is_ascii_lowercase()
+                    && id
+                        .bytes()
+                        .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-');
+                (valid_id && matches!(action, "select_claude" | "select_codex" | "reset_claude"))
+                    .then_some(kind)
+            }
+        }
+    }
+
+    pub(super) fn areas(&self, area: Rect) -> (Rect, Rect) {
+        let Some(document) = self.document.as_ref() else {
+            return (area, Rect::default());
+        };
+        let height = (document.rows.len().saturating_add(2).min(u16::MAX as usize) as u16)
+            .min(area.height.saturating_sub(8));
+        if height < 3 || area.width < 4 {
+            return (area, Rect::default());
+        }
+        (
+            Rect::new(area.x, area.y, area.width, area.height - height),
+            Rect::new(area.x, area.bottom() - height, area.width, height),
+        )
+    }
+
+    pub(super) fn render(
+        &self,
+        buffer: &mut Buffer,
+        area: Rect,
+        palette: &Palette,
+        scroll: usize,
+    ) -> usize {
+        let Some(document) = self.document.as_ref() else {
+            return 0;
+        };
+        if area.is_empty() {
+            return 0;
+        }
+        let width = area.width.saturating_sub(2);
+        let put = |buffer: &mut Buffer, y: u16, value: &str, style: Style| {
+            super::render::put_text(buffer, area.x + 1, y, width, value, style);
+        };
+        put(
+            buffer,
+            area.y,
+            &"─".repeat(usize::from(width)),
+            Style::default().fg(palette.overlay0),
+        );
+        let title = if self.stale {
+            format!("{} · stale", document.title)
+        } else {
+            document.title.clone()
+        };
+        put(
+            buffer,
+            area.y + 1,
+            &title,
+            Style::default()
+                .fg(palette.accent)
+                .add_modifier(Modifier::BOLD),
+        );
+        let height = usize::from(area.height.saturating_sub(2));
+        let max_scroll = document.rows.len().saturating_sub(height);
+        for (index, row) in document
+            .rows
+            .iter()
+            .skip(scroll.min(max_scroll))
+            .take(height)
+            .enumerate()
+        {
+            let mut style = match row.kind.split(':').next().unwrap_or("") {
+                "select_codex" | "codex" => Style::default()
+                    .fg(palette.green)
+                    .add_modifier(Modifier::BOLD),
+                "select_claude" | "claude" => Style::default()
+                    .fg(palette.mauve)
+                    .add_modifier(Modifier::BOLD),
+                "reset_codex" | "reset_claude" if !self.stale => Style::default()
+                    .fg(palette.accent)
+                    .add_modifier(Modifier::UNDERLINED | Modifier::BOLD),
+                "critical" => Style::default()
+                    .fg(palette.red)
+                    .add_modifier(Modifier::BOLD),
+                "warning" => Style::default().fg(palette.yellow),
+                "dim" => Style::default().fg(palette.overlay0),
+                _ => Style::default().fg(palette.text),
+            };
+            if self.stale {
+                style = style.add_modifier(Modifier::DIM);
+            }
+            put(buffer, area.y + 2 + index as u16, &row.text, style);
+        }
+        max_scroll
+    }
+}
+
+fn clean(value: &str, max: usize) -> String {
+    value
+        .chars()
+        .filter(|c| !c.is_control())
+        .take(max)
+        .collect()
+}
+
+impl super::ClientShellState {
+    pub(crate) fn tick_subscription_section(&mut self, now: Instant) -> bool {
+        self.subscription_section.poll(now)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn section(rows: usize) -> SubscriptionSection {
+        SubscriptionSection {
+            document: Some(Document {
+                schema: 1,
+                title: "Subscriptions (2)".into(),
+                valid_until: f64::MAX,
+                rows: (0..rows)
+                    .map(|i| Row {
+                        text: format!("row {i}"),
+                        kind: "text".into(),
+                    })
+                    .collect(),
+            }),
+            ..SubscriptionSection::default()
+        }
+    }
+
+    #[test]
+    fn reset_hit_matches_the_visible_scrolled_button() {
+        let mut section = section(6);
+        section.document.as_mut().unwrap().rows[4] = Row {
+            text: "[Use reset]".into(),
+            kind: "reset_codex".into(),
+        };
+        let area = Rect::new(0, 10, 25, 5);
+        assert_eq!(section.action_at(area, 999, (2, 13)), Some("codex"));
+        for point in [(2, 11), (2, 14), (20, 13), (0, 13)] {
+            assert_eq!(section.action_at(area, 999, point), None);
+        }
+        for kind in [
+            "select_claude:team",
+            "select_claude:ultra",
+            "select_codex:work",
+            "reset_claude:ultra",
+        ] {
+            section.document.as_mut().unwrap().rows[4].kind = kind.into();
+            assert_eq!(section.action_at(area, 999, (2, 13)), Some(kind));
+        }
+        section.document.as_mut().unwrap().rows[4].kind = "select_claude:../bad".into();
+        assert_eq!(section.action_at(area, 999, (2, 13)), None);
+        section.stale = true;
+        assert_eq!(section.action_at(area, 999, (2, 13)), None);
+    }
+
+    #[test]
+    fn own_section_reserves_bottom_without_becoming_an_agent_row() {
+        let section = section(12);
+        let (native, footer) = section.areas(Rect::new(0, 0, 30, 60));
+        assert_eq!(native, Rect::new(0, 0, 30, 46));
+        assert_eq!(footer, Rect::new(0, 46, 30, 14));
+        assert_eq!(native.bottom(), footer.y);
+        assert_eq!(footer.bottom(), 60);
+    }
+
+    #[test]
+    fn short_window_keeps_native_sidebar_usable_and_footer_scrollable() {
+        let (native, footer) = section(40).areas(Rect::new(0, 0, 26, 20));
+        assert_eq!(native.height, 8);
+        assert_eq!(footer.height, 12);
+    }
+
+    #[test]
+    fn disabled_extension_preserves_original_geometry() {
+        let area = Rect::new(0, 0, 26, 40);
+        assert_eq!(
+            SubscriptionSection::default().areas(area),
+            (area, Rect::default())
+        );
+    }
+
+    #[test]
+    fn section_renders_without_any_agent_or_workspace_dependency() {
+        let section = section(3);
+        let area = Rect::new(0, 0, 30, 8);
+        let mut buffer = Buffer::empty(area);
+        let config =
+            crate::client::shell::ClientShellConfig::from_config(&crate::config::Config::default());
+        assert_eq!(section.render(&mut buffer, area, &config.palette, 0), 0);
+        let text = buffer
+            .content
+            .iter()
+            .map(|c| c.symbol())
+            .collect::<String>();
+        assert!(text.contains("Subscriptions (2)"));
+        assert!(text.contains("row 0"));
+    }
+
+    #[test]
+    fn controls_and_newlines_cannot_escape_the_section() {
+        assert_eq!(clean("abc\n\r\u{1b}[31mxyz", 6), "abc[31");
+    }
+
+    #[test]
+    fn standalone_section_is_present_when_no_agent_exists() {
+        let mut config =
+            crate::client::shell::ClientShellConfig::from_config(&crate::config::Config::default());
+        config.startup_onboarding = false;
+        let mut shell = crate::client::shell::ClientShellState::new(config);
+        shell.subscription_section = section(12);
+        let frame = shell.compose(100, 60).expect("client frame");
+        let text = frame
+            .cells
+            .iter()
+            .map(|cell| cell.symbol.as_str())
+            .collect::<String>();
+        assert!(text.contains("Subscriptions (2)"));
+        assert!(shell.hits.subscription_area.y >= shell.hits.agent_body.bottom());
+        assert!(shell.hits.agents.is_empty());
+    }
+
+    #[test]
+    fn malformed_data_preserves_last_good_section_with_stale_marker() {
+        let path = std::env::temp_dir().join(format!(
+            "herdr-section-{}-{}.json",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .expect("clock")
+                .as_nanos()
+        ));
+        std::fs::write(&path, r#"{"schema":1,"title":"Subscriptions","valid_until":9999999999,"rows":[{"text":"Codex Pro","kind":"codex"}]}"#).expect("fixture");
+        let now = Instant::now();
+        let mut reader = SubscriptionSection {
+            path: Some(path.clone()),
+            ..SubscriptionSection::default()
+        };
+        assert!(reader.poll(now));
+        assert!(!reader.stale);
+        std::fs::write(&path, "invalid json").expect("bad fixture");
+        assert!(reader.poll(now + Duration::from_secs(2)));
+        assert!(reader.stale);
+        assert_eq!(
+            reader.document.as_ref().expect("last good document").rows[0].text,
+            "Codex Pro"
+        );
+        std::fs::remove_file(path).expect("cleanup");
+    }
+
+    #[test]
+    fn oversized_payload_does_not_allocate_a_section() {
+        let path = std::env::temp_dir().join(format!(
+            "herdr-section-large-{}-{}.json",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .expect("clock")
+                .as_nanos()
+        ));
+        std::fs::write(&path, vec![b' '; MAX_BYTES as usize + 1]).expect("large fixture");
+        let mut reader = SubscriptionSection {
+            path: Some(path.clone()),
+            ..SubscriptionSection::default()
+        };
+        reader.poll(Instant::now());
+        assert!(reader.document.is_none());
+        std::fs::remove_file(path).expect("cleanup");
+    }
