{
  "manifest_version": 3,
  "name": "Herdr Claude reset monitor",
  "version": "0.4.0",
  "description": "Check Claude saved resets daily and when a quota fills, without opening a tab.",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "monitor.js"
  },
  "host_permissions": [
    "https://claude.ai/*"
  ]
}
